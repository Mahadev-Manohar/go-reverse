
FROM golang:1.27.1-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/backend ./cmd/backend

RUN CGO_ENABLED=0 GOOS=linux go build \
    -o /backend ./cmd/backend

FROM alpine:3.22

RUN apk --no-cache add ca-certificates

COPY --from=builder /backend /backend

EXPOSE 9001

ENTRYPOINT ["/backend"]
